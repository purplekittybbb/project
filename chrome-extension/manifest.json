{
  "manifest_version": 3,
  "name": "TrueMargin Asistan",
  "version": "1.1.0",
  "description": "Kendi ürünleriniz için net kâr/zarar gösterimi — hesabınızı bağlayın, gerçek verinizden hesaplasın",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://matsorular.vercel.app/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://partner.trendyol.com/*",
        "https://partner.hepsiburada.com/*",
        "https://so.n11.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
